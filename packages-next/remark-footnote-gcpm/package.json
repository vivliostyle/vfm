{
  "name": "@vivliostyle/remark-footnote-gcpm-next",
  "private": true,
  "version": "1.0.1",
  "description": "GCPM-style inline footnote plugin used by VFM. Emits `<span class=\"footnote\">` elements at the call site, with duplicate references rendered as `<a class=\"footnote-duplicated-call\">`.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">= 22"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vivliostyle/vfm.git",
    "directory": "packages-next/remark-footnote-gcpm"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "shx rm -rf lib && tsc",
    "test": "tsc --project tests/tsconfig.json && vitest run",
    "format": "prettier --write --ignore-path ../../.gitignore --ignore-path ../../.prettierignore .",
    "lint": "eslint --fix ."
  },
  "dependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@vivliostyle/vfm-internal-utils-next": "workspace:*",
    "hastscript": "^9.0.1",
    "mdast-util-to-hast": "^13.2.1",
    "unified": "^11.0.5",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@vivliostyle/remark-footnote-inline-next": "workspace:*",
    "rehype-format": "^5.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2"
  }
}
