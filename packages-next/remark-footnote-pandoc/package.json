{
  "name": "@vivliostyle/remark-footnote-pandoc-next",
  "private": true,
  "version": "1.0.1",
  "description": "Pandoc-style endnote rewriter used by VFM. Converts mdast-util-to-hast's default endnote markup into a `<section role=\"doc-endnotes\">` block with renumbering and duplicate-call backlinks.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">= 22"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vivliostyle/vfm.git",
    "directory": "packages-next/remark-footnote-pandoc"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "shx rm -rf lib && tsc",
    "test": "tsc --project tests/tsconfig.json && vitest run",
    "format": "prettier --write --ignore-path ../../.gitignore --ignore-path ../../.prettierignore .",
    "lint": "eslint --fix ."
  },
  "dependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "hast-util-select": "^6.0.4",
    "hastscript": "^9.0.1",
    "mdast-util-to-hast": "^13.2.1",
    "unified": "^11.0.5",
    "unist-builder": "^4.0.0",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "rehype-format": "^5.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2"
  }
}
