{
  "name": "@vivliostyle/remark-sectionize-next",
  "private": true,
  "version": "1.0.1",
  "description": "remark plugin to wrap headings in `<section class=\"levelN\">` elements, with VFM-specific extensions for non-section markers and section-end marks. Derived from `remark-sectionize` (Jake Low, 2019).",
  "license": "MIT",
  "engines": {
    "node": ">= 22"
  },
  "type": "module",
  "main": "lib/section.js",
  "types": "lib/section.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vivliostyle/vfm.git",
    "directory": "packages-next/remark-sectionize"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "shx rm -rf lib && tsc",
    "test": "tsc --project tests/tsconfig.json && vitest run",
    "format": "prettier --write --ignore-path ../../.gitignore --ignore-path ../../.prettierignore .",
    "lint": "eslint --fix ."
  },
  "dependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "mdast-util-to-hast": "^13.2.1",
    "unist-util-find-after": "^5.0.0",
    "unist-util-visit-parents": "^6.0.2",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@vivliostyle/remark-attribute-next": "workspace:*",
    "rehype-format": "^5.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  }
}
