{
  "name": "@vivliostyle/vfm-next",
  "private": true,
  "description": "Custom Markdown syntax specialized in book authoring.",
  "version": "2.7.2",
  "author": "Vivliostyle Foundation",
  "license": "Apache-2.0",
  "engines": {
    "node": ">= 22"
  },
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "vfm": "lib/cli.js"
  },
  "keywords": [
    "markdown",
    "vfm",
    "vivliostyle"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vivliostyle/vfm.git",
    "directory": "packages-next/vfm"
  },
  "homepage": "https://github.com/vivliostyle/vfm",
  "bugs": {
    "url": "https://github.com/vivliostyle/vfm/issues"
  },
  "files": [
    "lib"
  ],
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "shx rm -rf lib && tsc && shx chmod +x lib/cli.js",
    "dev": "tsc -w",
    "test": "tsc --project tests/tsconfig.json && vitest run",
    "format": "prettier --write --ignore-path ../../.gitignore --ignore-path ../../.prettierignore .",
    "lint": "eslint --fix ."
  },
  "//": {
    "dependencies.{@types/unist,@types/hast,@types/mdast,vfile}": [
      "@types/unist, @types/hast, @types/mdast, vfile は vfm の公開 API に現れるため、ユーザーにも型パッケージをインストールさせる必要がある",
      "さらにバージョンを Major 固定し、依存ツリー内で異なる Minor/Patch バージョンの重複インストール発生を防ぐ。これは unified の作者も使用しているパターン",
      "see: https://github.com/wooorm/refractor/blob/ed824ac801ef4bb5b25f73a4bcd6ce46b7eec8c9/package.json#L14"
    ]
  },
  "dependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "@vivliostyle/mdast-to-hast-table-cell-next": "workspace:*",
    "@vivliostyle/rehype-rewrite-extension-next": "workspace:*",
    "@vivliostyle/remark-footnote-dpub-next": "workspace:*",
    "@vivliostyle/remark-footnote-gcpm-next": "workspace:*",
    "@vivliostyle/remark-footnote-pandoc-next": "workspace:*",
    "@vivliostyle/remark-ruby-next": "workspace:*",
    "@vivliostyle/remark-sectionize-next": "workspace:*",
    "@vivliostyle/vfm-internal-utils-next": "workspace:*",
    "debug": "^4.4.3",
    "github-slugger": "^2.0.0",
    "hast-util-find-and-replace": "^5.0.2",
    "hast-util-from-html": "^2.0.3",
    "hast-util-is-element": "^3.0.0",
    "hast-util-raw": "^9.1.0",
    "hast-util-select": "^6.0.4",
    "hastscript": "^9.0.1",
    "js-yaml": "^4.3.2",
    "md-attr-parser": "^1.3.0",
    "mdast-util-find-and-replace": "^3.0.3",
    "mdast-util-to-hast": "^13.2.1",
    "mdast-util-to-string": "^4.0.0",
    "meow": "^13.2.0",
    "refractor": "^5.0.0",
    "rehype-format": "^5.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-footnotes": "^2.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-shortcodes": "^0.3.1",
    "temml": "^0.13.0",
    "to-vfile": "^8.0.0",
    "unified": "^11.0.5",
    "unist-builder": "^4.0.0",
    "unist-util-filter": "^5.0.1",
    "unist-util-find-after": "^5.0.0",
    "unist-util-inspect": "^8.1.0",
    "unist-util-remove": "^4.0.0",
    "unist-util-select": "^5.1.0",
    "unist-util-visit": "^5.1.0",
    "unist-util-visit-parents": "^6.0.2",
    "valibot": "1.4.2",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@types/common-tags": "^1.8.4",
    "@types/debug": "^4.1.12",
    "@types/js-yaml": "^4.0.9",
    "common-tags": "^1.8.2"
  }
}
